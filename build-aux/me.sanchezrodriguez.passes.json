{
    "app-id" : "me.sanchezrodriguez.passes",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "passes",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--device=all",
        "--socket=wayland",
        "--talk-name=org.freedesktop.portal.Desktop",
        "--talk-name=org.freedesktop.portal.Camera",
        "--talk-name=org.freedesktop.portal.Screenshot"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        "zint.json",
        "python3-scikit-build-core.json",
        "python3-nanobind.json",
        "python3-zxing-cpp.json",
        "python3-pybind11.json",
        "python3-pillow.json",
        {
            "name" : "passes",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : ".."
                }
            ]
        }
    ]
}
